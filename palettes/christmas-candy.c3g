linear-gradient(
  0deg,
  rgb(255,255,255)   0.000%,
  rgb(255,  0,  0)  10.000%,
  rgb(255,255,255)  20.000%,
  rgb(  0,128,  0)  30.000%,
  rgb(255,255,255)  40.000%,
  rgb(255,  0,  0)  50.000%,
  rgb(255,255,255)  60.000%,
  rgb(  0,128,  0)  70.000%,
  rgb(255,255,255)  80.000%,
  rgb(255,  0,  0)  90.000%,
  rgb(255,255,255) 100.000%
  );
