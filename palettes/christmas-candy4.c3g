linear-gradient(
  0deg, 
  rgb(255,228,186) 0.000%
  rgb(255,0,0) 10.000%,
  rgb(255,228,186) 20%,
  rgb(0,255,0) 30.000%,
  rgb(255,228,186) 40%,
  rgb(255,0,0) 50.000%,
  rgb(255,228,186) 60.000%,
  rgb(0,255,0) 70.000%,
  rgb(255,228,186) 80.000%,
  rgb(255,0,0) 90.000%,
  rgb(255,228,186) 100.000%
  );